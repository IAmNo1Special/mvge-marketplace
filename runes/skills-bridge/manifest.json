{
  "name": "skills-bridge",
  "version": "0.1.0",
  "description": "Official Agent Skills (agentskills.io) and Agent Plugins bridge for Mvge",
  "types": [
    "Sigil",
    "Spell",
    "Command",
    "UIView"
  ],
  "runtime": "python",
  "entry_point": "rune.py",
  "hooks": [
    "session_start",
    "before_mvge_start",
    "context_transform",
    "session_shutdown"
  ],
  "commands": [
    "skill"
  ],
  "ui": {
    "views": [
      {
        "id": "skills",
        "title": "Skills",
        "icon": "auto_awesome",
        "order": 50,
        "description": "Official Agent Skills and Plugins management surface"
      }
    ]
  },
  "python_deps": [
    "pyyaml>=6.0",
    "typer>=0.12"
  ],
  "execution_mode": "parallel",
  "enabled": true
}
